#!/bin/bash

# Menu de la tarea 993

while true
do
    echo "========================"
    echo "       MENU"
    echo "========================"
    echo "1) Crear arbol de directorios"
    echo "2) Hola Mundo"
    echo "3) Saludo con variables"
    echo "4) Salir"
    echo "========================"
    echo -n "Elige una opcion: "
    read opcion

    if [ $opcion -eq 1 ]
    then
        echo "Creando arbol de directorios..."
        mkdir -p arbol/documentos
        mkdir -p arbol/imagenes
        mkdir -p arbol/videos
        mkdir -p arbol/documentos/trabajo
        mkdir -p arbol/documentos/personal
        echo "Arbol creado:"
        ls -R arbol
        echo ""

    elif [ $opcion -eq 2 ]
    then
        echo "Hola Mundo"
        echo ""

    elif [ $opcion -eq 3 ]
    then
        echo -n "Escribe tu nombre: "
        read nombre
        saludo="Hola"
        echo "$saludo $nombre"
        echo ""

    elif [ $opcion -eq 4 ]
    then
        echo "Saliendo..."
        exit

    else
        echo "Opcion no valida"
        echo ""
    fi

    echo -n "Presiona Enter para continuar..."
    read
done